{
  "tool": {
    "id": "apache-ii",
    "title": "APACHE II",
    "short": "Gravidade e mortalidade prevista na UTI",
    "desc": "Calcule o APACHE II com os piores valores das primeiras 24 h de UTI: escore fisiológico, idade, doença crônica e mortalidade hospitalar prevista.",
    "lead": "Estima a gravidade da doença e a mortalidade hospitalar de pacientes adultos admitidos na UTI, a partir de 12 variáveis fisiológicas, idade, doença crônica e categoria diagnóstica.",
    "kind": "Calculadora",
    "spec": [
      "medicina-intensiva",
      "medicina-de-emergencia",
      "anestesiologia"
    ],
